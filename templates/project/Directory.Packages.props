<Project>
    <!-- Central Package Management: every NuGet version lives here. Ask before adding packages (CLAUDE.md). -->
    <PropertyGroup>
        <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    </PropertyGroup>

    <ItemGroup Label="Analyzers">
        <PackageVersion Include="StyleCop.Analyzers" Version="1.2.0-beta.556" />
        <PackageVersion Include="Roslynator.Analyzers" Version="5.0.1" />
        <PackageVersion Include="Microsoft.CodeAnalysis.BannedApiAnalyzers" Version="5.6.0" />
    </ItemGroup>

    <ItemGroup Label="Testing">
        <PackageVersion Include="xunit.v3" Version="4.0.1" />
        <PackageVersion Include="coverlet.MTP" Version="10.1.0" />
    </ItemGroup>
</Project>
